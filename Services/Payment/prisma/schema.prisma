enum PaymentStatus {
  PROCESSING
  SUCCESS
  FAILED
}

enum Currency {
  INR
}

enum PaymentFailureCode {
  INSUFFICIENT_BALANCE
  WALLET_NOT_FOUND
  WALLET_FROZEN
  SELF_TRANSFER_NOT_ALLOWED
  INTERNAL_ERROR
}
enum IdempotencyStatus {
  PROCESSING
SUCCESS
FAILED
}
model Payment {
  id               String   @id @default(uuid()) @db.Uuid

  senderWalletId   String   @db.Uuid
  receiverWalletId String   @db.Uuid

  amount           Decimal  @db.Decimal(18, 2)
  currency         Currency @default(INR)

  status           PaymentStatus

  // Nullable because it is only populated when status = FAILED
  failureCode      PaymentFailureCode?

  // Optional business metadata
  description      String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt


  // One Payment -> Many Ledger Entries
  ledgers          Ledger[]

  // One Payment <-> One Idempotency Record
  idempotency      IdempotencyKey

  // Indexes
  @@index([senderWalletId])
  @@index([receiverWalletId])
  @@index([senderWalletId, createdAt])
  @@index([status, createdAt])

  @@map("payments")
}

model Ledger {
  id        String  @id @default(uuid()) @db.Uuid

  paymentId String  @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id])
}
model IdempotencyKey {
  id              String             @id @default(uuid()) @db.Uuid

  idempotencyKey  String

  userId          String             @db.Uuid

  requestHash     String

  status          IdempotencyStatus

  response        Json?

  createdAt       DateTime           @default(now()) @map("created_at")
  expiresAt       DateTime           @map("expires_at")

  @@unique([userId, idempotencyKey])

  @@map("idempotency_keys")
}